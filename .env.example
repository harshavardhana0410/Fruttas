# Copy to .env.local and fill in. .env.local is gitignored.
#
# ONLY the publishable key belongs here. Vite inlines every VITE_-prefixed
# variable into the JavaScript bundle, so anything in this file is readable by
# every visitor. A service_role key placed here is a full database breach —
# being gitignored does not make it secret once Vite has bundled it.
#
# Local:  values printed by `supabase start`
# Hosted: Dashboard > Project Settings > API

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
